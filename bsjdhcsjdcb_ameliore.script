% General Mission Analysis Tool (GMAT) Script
% GEO station keeping -- corrected and simplified version
% The original file, bsjdhcsjdcb.script, is retained unchanged.

%----------------------------------------
% Spacecraft and hardware
%----------------------------------------
Create Spacecraft GEOSAT;
GEOSAT.DateFormat = TAIModJulian;
GEOSAT.Epoch = '21545';
GEOSAT.CoordinateSystem = EarthMJ2000Eq;
GEOSAT.DisplayStateType = Keplerian;
GEOSAT.SMA = 42164.17000000003;
GEOSAT.ECC = 5.612411358545992e-17;
GEOSAT.INC = 0;
GEOSAT.RAAN = 0;
GEOSAT.AOP = 0;
GEOSAT.TA = 120;
GEOSAT.DryMass = 1800;
GEOSAT.Cd = 2.2;
GEOSAT.Cr = 1.8;
GEOSAT.DragArea = 15;
GEOSAT.SRPArea = 1;
GEOSAT.Tanks = {ElectricTank1};
GEOSAT.Thrusters = {ElectricThruster1, ElectricThruster2, ElectricThruster3, ElectricThruster4};
GEOSAT.PowerSystem = SolarPowerSystem1;
GEOSAT.OrbitColor = Red;
GEOSAT.TargetColor = Teal;

Create ElectricTank ElectricTank1;
ElectricTank1.AllowNegativeFuelMass = false;
ElectricTank1.FuelMass = 756;

% VNB axes: V = along-track, N = orbit normal, B = radial.
% Thrusters 1/2 correct longitude; thrusters 3/4 correct inclination.
Create ElectricThruster ElectricThruster1;
ElectricThruster1.CoordinateSystem = Local;
ElectricThruster1.Origin = Earth;
ElectricThruster1.Axes = VNB;
ElectricThruster1.ThrustDirection1 = 1;
ElectricThruster1.ThrustDirection2 = 0;
ElectricThruster1.ThrustDirection3 = 0;
ElectricThruster1.DutyCycle = 1;
ElectricThruster1.DecrementMass = true;
ElectricThruster1.Tank = {ElectricTank1};
ElectricThruster1.MixRatio = [ 1 ];
ElectricThruster1.ThrustModel = ConstantThrustAndIsp;
ElectricThruster1.Isp = 4200;
ElectricThruster1.ConstantThrust = 0.237;

Create ElectricThruster ElectricThruster2;
ElectricThruster2.CoordinateSystem = Local;
ElectricThruster2.Origin = Earth;
ElectricThruster2.Axes = VNB;
ElectricThruster2.ThrustDirection1 = -1;
ElectricThruster2.ThrustDirection2 = 0;
ElectricThruster2.ThrustDirection3 = 0;
ElectricThruster2.DutyCycle = 1;
ElectricThruster2.DecrementMass = true;
ElectricThruster2.Tank = {ElectricTank1};
ElectricThruster2.MixRatio = [ 1 ];
ElectricThruster2.ThrustModel = ConstantThrustAndIsp;
ElectricThruster2.Isp = 4200;
ElectricThruster2.ConstantThrust = 0.237;

Create ElectricThruster ElectricThruster3;
ElectricThruster3.CoordinateSystem = Local;
ElectricThruster3.Origin = Earth;
ElectricThruster3.Axes = VNB;
ElectricThruster3.ThrustDirection1 = 0;
ElectricThruster3.ThrustDirection2 = 1;
ElectricThruster3.ThrustDirection3 = 0;
ElectricThruster3.DutyCycle = 1;
ElectricThruster3.DecrementMass = true;
ElectricThruster3.Tank = {ElectricTank1};
ElectricThruster3.MixRatio = [ 1 ];
ElectricThruster3.ThrustModel = ConstantThrustAndIsp;
ElectricThruster3.Isp = 4200;
ElectricThruster3.ConstantThrust = 0.237;

Create ElectricThruster ElectricThruster4;
ElectricThruster4.CoordinateSystem = Local;
ElectricThruster4.Origin = Earth;
ElectricThruster4.Axes = VNB;
ElectricThruster4.ThrustDirection1 = 0;
ElectricThruster4.ThrustDirection2 = -1;
ElectricThruster4.ThrustDirection3 = 0;
ElectricThruster4.DutyCycle = 1;
ElectricThruster4.DecrementMass = true;
ElectricThruster4.Tank = {ElectricTank1};
ElectricThruster4.MixRatio = [ 1 ];
ElectricThruster4.ThrustModel = ConstantThrustAndIsp;
ElectricThruster4.Isp = 4200;
ElectricThruster4.ConstantThrust = 0.237;

Create SolarPowerSystem SolarPowerSystem1;
SolarPowerSystem1.EpochFormat = 'UTCGregorian';
SolarPowerSystem1.InitialEpoch = '01 Jan 2000 11:59:28.000';
% At least one 7.266-kW thruster must be supportable.
SolarPowerSystem1.InitialMaxPower = 8.0;
SolarPowerSystem1.AnnualDecayRate = 5;
SolarPowerSystem1.Margin = 5;
SolarPowerSystem1.BusCoeff1 = 0.3;
SolarPowerSystem1.ShadowModel = 'None';

%----------------------------------------
% Dynamics and propagator
%----------------------------------------
Create ForceModel DefaultProp_ForceModel;
DefaultProp_ForceModel.CentralBody = Earth;
DefaultProp_ForceModel.PrimaryBodies = {Earth};
DefaultProp_ForceModel.PointMasses = {Luna, Sun};
DefaultProp_ForceModel.SRP = On;
DefaultProp_ForceModel.RelativisticCorrection = On;
DefaultProp_ForceModel.ErrorControl = RSSStep;
DefaultProp_ForceModel.GravityField.Earth.Degree = 4;
DefaultProp_ForceModel.GravityField.Earth.Order = 4;
DefaultProp_ForceModel.GravityField.Earth.PotentialFile = 'JGM2.cof';
DefaultProp_ForceModel.GravityField.Earth.TideModel = 'None';
DefaultProp_ForceModel.SRP.Flux = 1367;
DefaultProp_ForceModel.SRP.SRPModel = Spherical;
DefaultProp_ForceModel.SRP.Nominal_Sun = 149597870.691;

Create Propagator DefaultProp;
DefaultProp.FM = DefaultProp_ForceModel;
DefaultProp.Type = RungeKutta89;
DefaultProp.InitialStepSize = 60;
DefaultProp.Accuracy = 1e-11;
DefaultProp.MinStep = 0.001;
DefaultProp.MaxStep = 2700;
DefaultProp.MaxStepAttempts = 50;
DefaultProp.StopIfAccuracyIsViolated = true;

%----------------------------------------
% Burns, monitoring, and report
%----------------------------------------
Create FiniteBurn EastToWestBurn;
EastToWestBurn.Thrusters = {ElectricThruster1};
EastToWestBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn WestToEastBurn;
WestToEastBurn.Thrusters = {ElectricThruster2};
WestToEastBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn NorthSouthBurn;
NorthSouthBurn.Thrusters = {ElectricThruster3};
NorthSouthBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn SouthNorthBurn;
SouthNorthBurn.Thrusters = {ElectricThruster4};
SouthNorthBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create ReportFile StationKeepingReport;
StationKeepingReport.Filename = 'StationKeepingReport.txt';
StationKeepingReport.Precision = 16;
StationKeepingReport.WriteHeaders = true;

Create Variable tolerance_ecc tolerance_northsouth tolerance_eastwest mission_days;
Create Variable targetlongitude targetECC longitudeError inclinationError eccentricityError;
Create Variable burnDuration maxBurnDuration minBurnDuration;
tolerance_ecc = 0.004;
tolerance_northsouth = 0.1;
tolerance_eastwest = 0.1;
mission_days = 300;
maxBurnDuration = 3600;
minBurnDuration = 800;

%----------------------------------------
% Mission sequence
%----------------------------------------
BeginMissionSequence;

targetlongitude = GEOSAT.Earth.Longitude;
targetECC = GEOSAT.Earth.ECC;

% Let the initial state settle before the first station-keeping decision.
Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = 86400};

While GEOSAT.ElapsedDays < mission_days

   % At an equatorial crossing, use the sign of VZ to choose the normal burn.
   Propagate DefaultProp(GEOSAT) {GEOSAT.EarthMJ2000Eq.Z = 0};
   inclinationError = GEOSAT.EarthMJ2000Eq.INC;
   If inclinationError > 0.5 * tolerance_northsouth
      burnDuration = minBurnDuration + minBurnDuration * inclinationError / tolerance_northsouth;
      If burnDuration > maxBurnDuration
         burnDuration = maxBurnDuration;
      EndIf;
      If GEOSAT.EarthMJ2000Eq.VZ > 0
         BeginFiniteBurn SouthNorthBurn(GEOSAT);
         Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnDuration};
         EndFiniteBurn SouthNorthBurn(GEOSAT);
      Else
         BeginFiniteBurn NorthSouthBurn(GEOSAT);
         Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnDuration};
         EndFiniteBurn NorthSouthBurn(GEOSAT);
      EndIf;
   EndIf;

   % Normalize to [-180, 180] so the +/-180 degree discontinuity cannot
   % command an excessively long longitude correction.
   longitudeError = GEOSAT.Earth.Longitude - targetlongitude;
   If longitudeError > 180
      longitudeError = longitudeError - 360;
   EndIf;
   If longitudeError < -180
      longitudeError = longitudeError + 360;
   EndIf;

   If longitudeError > 0.5 * tolerance_eastwest
      burnDuration = minBurnDuration + minBurnDuration * longitudeError / tolerance_eastwest;
      If burnDuration > maxBurnDuration
         burnDuration = maxBurnDuration;
      EndIf;
      BeginFiniteBurn EastToWestBurn(GEOSAT);
      Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnDuration};
      EndFiniteBurn EastToWestBurn(GEOSAT);
   EndIf;

   If longitudeError < -0.5 * tolerance_eastwest
      burnDuration = minBurnDuration - minBurnDuration * longitudeError / tolerance_eastwest;
      If burnDuration > maxBurnDuration
         burnDuration = maxBurnDuration;
      EndIf;
      BeginFiniteBurn WestToEastBurn(GEOSAT);
      Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnDuration};
      EndFiniteBurn WestToEastBurn(GEOSAT);
   EndIf;

   % Existing hardware has no radial (B-axis) thruster, so eccentricity is
   % monitored rather than corrected. Add a radial pair before closing this loop.
   eccentricityError = GEOSAT.Earth.ECC - targetECC;
   Report StationKeepingReport GEOSAT.ElapsedDays GEOSAT.Earth.Longitude longitudeError GEOSAT.EarthMJ2000Eq.INC eccentricityError GEOSAT.ElectricTank1.FuelMass;

EndWhile;

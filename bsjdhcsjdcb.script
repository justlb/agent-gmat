NewView2.CurrentCenter = [ 0 3.637978807091713e-11 -1.091393642127514e-11 ];
NewView2.CurrentUp = [ -0.04629214246546121 0.2358890693215285 0.9706767662412553 ];
NewView2.FOVy = 45;

Create OpenFramesView NewView3;
NewView3.ViewFrame = GEOSAT;
NewView3.ViewTrajectory = Off;
NewView3.InertialFrame = Off;
NewView3.SetDefaultLocation = Off;
NewView3.SetCurrentLocation = Off;
NewView3.FOVy = 45;

Create OpenFramesView NewView1;
NewView1.ViewFrame = GEOSAT;
NewView1.ViewTrajectory = Off;
NewView1.InertialFrame = Off;
NewView1.SetDefaultLocation = Off;
NewView1.SetCurrentLocation = On;
NewView1.CurrentEye = [ -21671.021322198 -1257.879820450689 -3247.4269510228 ];
NewView1.CurrentCenter = [ 12.50000000001455 237.2500000000189 118.4999999999795 ];
NewView1.CurrentUp = [ -0.1078058523844734 -0.4416665916563636 0.8906786850521956 ];
NewView1.FOVy = 45;

Create OpenFramesView NewView4;
NewView4.ViewFrame = GEOSAT;
NewView4.ViewTrajectory = Off;
NewView4.InertialFrame = Off;
NewView4.SetDefaultLocation = Off;
NewView4.SetCurrentLocation = On;
NewView4.CurrentEye = [ -1008.379263368065 -42275.36585422426 36655.36732776287 ];
NewView4.CurrentCenter = [ 12.49999999999829 237.2500000000437 118.4999999999854 ];
NewView4.CurrentUp = [ -0.1804725440273197 0.6435799345729305 0.7437973707048241 ];
NewView4.FOVy = 45;

Create OpenFramesView OrbitView2_View;
OrbitView2_View.ViewFrame = CoordinateSystem;
OrbitView2_View.ViewTrajectory = Off;
OrbitView2_View.InertialFrame = Off;
OrbitView2_View.SetDefaultLocation = On;
OrbitView2_View.DefaultEye = [ 30000 0 0 ];
OrbitView2_View.DefaultCenter = [ 0 0 0 ];
OrbitView2_View.DefaultUp = [ 0 0 1 ];
OrbitView2_View.SetCurrentLocation = Off;
OrbitView2_View.FOVy = 45;



%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
targetlongitude = GEOSAT.Earth.Longitude;
Mlongitude = targetlongitude + tolerance_eastwest;
mlongitude = targetlongitude - tolerance_eastwest;
targetlatitude = GEOSAT.Earth.Latitude;
Mlatitude = targetlatitude + tolerance_northsouth;
mlatitude = targetlatitude - tolerance_northsouth;
sat_INC = GEOSAT.EarthMJ2000Eq.INC;
MINC = sat_INC + tolerance_northsouth;
mINC = sat_INC - tolerance_northsouth;
targetECC = GEOSAT.Earth.ECC;
MECC = targetECC + tolereance_ecc;
mECC = targetECC - tolereance_ecc;
X = targetlongitude;
Y = targetlatitude;




Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = 86400};

While GEOSAT.ElapsedDays < daysofOK
   
   Propagate DefaultProp(GEOSAT) {GEOSAT.EarthMJ2000Eq.Z = 0};
   
   Y = tolerance_northsouth* 0.5;
   If GEOSAT.EarthMJ2000Eq.INC > Y
      If GEOSAT.EarthMJ2000Eq.VZ > 0
         burnduration = 1600;
         BeginFiniteBurn FiniteBurn4(GEOSAT);
         Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnduration};
         EndFiniteBurn FiniteBurn4(GEOSAT);
      
      EndIf;
      
      If GEOSAT.EarthMJ2000Eq.VZ < 0
         burnduration = 1600;
         BeginFiniteBurn FiniteBurn3(GEOSAT);
         Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnduration};
         EndFiniteBurn FiniteBurn3(GEOSAT);
      
      EndIf;
   EndIf;
   
   
   
   X = targetlongitude + 0.5 * tolerance_eastwest;
   If GEOSAT.Earth.Longitude > X
      eLONG = targetlongitude - GEOSAT.Earth.Longitude;
      burnduration = 1600 + eLONG*50;
      BeginFiniteBurn FiniteBurn1(GEOSAT);
      Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnduration};
      EndFiniteBurn FiniteBurn1(GEOSAT);
      burnduration = (1600 + eLONG*50)/2;
      Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnduration};
      eLONG = GEOSAT.Earth.Longitude - targetlongitude;
   
   
   EndIf;
   
   
   
   Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = 1200};
   
   X = targetlongitude - 0.5 * tolerance_eastwest;
   
   If GEOSAT.Earth.Longitude < X
      eLONG = targetlongitude - GEOSAT.Earth.Longitude;
      burnduration = 1600 + eLONG*50;
      BeginFiniteBurn FiniteBurn2(GEOSAT);
      Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnduration};
      EndFiniteBurn FiniteBurn2(GEOSAT);
      burnduration = (1600 + eLONG*50)/2;
      Propagate DefaultProp(GEOSAT) {GEOSAT.ElapsedSecs = burnduration};
      eLONG = targetlongitude - GEOSAT.Earth.Longitude;
   
   EndIf;





EndWhile;
   
   





XYPlot7.YVariables = {GEOSAT.ElectricTank1.FuelMass};
XYPlot7.ShowGrid = true;
XYPlot7.ShowPlot = true;

%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------
Create Variable tolereance_ecc tolerance_northsouth tolerance_eastwest daysofOK Mlongitude mlongitude targetlongitude sat_INC MINC mINC;
Create Variable Mlatitude mlatitude targetlatitude targetECC MECC mECC proptime1 proptime2 eLONG eLONGcorrected;
Create Variable burnduration X eECC eINC Y;
Create String a b;
tolereance_ecc = 0.004;
tolerance_northsouth = 0.1;
tolerance_eastwest = 0.1;
daysofOK = 300;
Mlongitude = 0;
mlongitude = 0;
targetlongitude = 0;
sat_INC = 0;
MINC = 0;
mINC = 0;
Mlatitude = 0;
mlatitude = 0;
targetlatitude = 0;
targetECC = 0;
MECC = 0;
mECC = 0;
proptime1 = 0;
proptime2 = 0;
eLONG = 0;
eLONGcorrected = 0;
burnduration = 1600;
X = 0;
eECC = 0;
eINC = 0;
Y = 0;
a = 'a';
b = 'b';



%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView OrbitView1_View;
OrbitView1_View.ViewFrame = CoordinateSystem;
OrbitView1_View.ViewTrajectory = Off;
OrbitView1_View.InertialFrame = Off;
OrbitView1_View.SetDefaultLocation = On;
OrbitView1_View.DefaultEye = [ 30000 0 0 ];
OrbitView1_View.DefaultCenter = [ 0 0 0 ];
OrbitView1_View.DefaultUp = [ 0 0 1 ];
OrbitView1_View.SetCurrentLocation = Off;
OrbitView1_View.FOVy = 45;


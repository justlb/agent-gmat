    "opalis": {
      "_comment": "Optional. Configure these paths only when OPALIS and Simu-CIC are installed on this computer.",
      "baseScenario": null,
      "celestlabDir": null,
      "installationDir": null,
      "scilabBin": null,
      "simucicDir": null,
      "simuCicRunner": null,
      "timeoutMs": 600000,
      "workerPython": null

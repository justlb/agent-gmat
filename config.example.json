    "cad": { "displayNum": ":1", "launcher": "/bin/true", "bin": null, "vncPort": 5901, "noVncPort": 6080 },
    "paraview": { "displayNum": ":2", "launcher": "/bin/true", "vncPort": 5902, "noVncPort": 6081 },
    "comsol": { "displayNum": ":32", "launcher": "/bin/true", "sudo": "sudo", "vncPort": 5932, "noVncPort": 6082 },
    "gmat": {
      "bin": "/mnt/c/Program Files/GMAT/bin/GmatConsole.exe",
      "guiBin": "/mnt/c/Program Files/GMAT/bin/GMAT.exe",
      "timeoutMs": 120000

  "frontend": { "host": "0.0.0.0", "publicHost": "127.0.0.1", "port": 5174, "httpsPort": 5175, "strictPort": true },
  "workspace": {
    "templateDir": "/mnt/d/path/to/agent-gmat-main/data/input_data",
    "usersRoot": "/mnt/d/path/to/agent-gmat-main/data/user",
    "filesystemGroup": "",
    "rpcHost": "localhost",
    "rpcPort": 9877,
    "componentInfoMaxStepSizeMb": 6.5,
    "filePreviewMaxBytes": 5242880,
    "textFileMaxBytes": 67108864,

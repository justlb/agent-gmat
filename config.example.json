    "rfComlink": {
      "_comment": "Required to calculate RF link budgets. Point home to the folder that contains rf-comlink.exe.",
      "home": "REPLACE_WITH_RF_COMLINK_HOME",
      "python": null,
      "waitSeconds": 3
    }
  },
  "auth": { "enabled": false, "headerName": "x-codex-user-id", "cookieName": "codex_user_id", "devUserId": "default", "usersDir": "users" },
  "logging": { "level": "info", "file": "logs/app.log", "alsoStdout": true }

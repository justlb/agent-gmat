{
  "id": "chemical-3d-transfer",
  "name": "Chemical 3D GEO transfer",
  "description": "Three-burn chemical transfer from an inclined Earth orbit to a near-geosynchronous orbit.",
  "analysis_request_key": "chemical_3d_transfer",
  "draft_directory": ["gmat", "chemical-3d-transfer", "drafts"],
  "chat_mode": "gmat-chemical-3d",
  "gmat_reference_script": "Ex_GEOTransfer.script",
  "artifacts": [
    { "path": "chemical_3d_transfer.script", "kind": "script", "primary": true },

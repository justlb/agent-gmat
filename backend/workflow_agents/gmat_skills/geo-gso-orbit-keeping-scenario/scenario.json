{
  "id": "geo-gso-orbit-keeping",
  "name": "GEO Station Keeping — Chemical",
  "description": "Chemical GEO station keeping with impulsive East/West and node-based North/South deadband corrections.",
  "analysis_request_key": "geo_gso_orbit_keeping",
  "draft_directory": [
    "gmat",
    "geo-gso-orbit-keeping",
    "drafts"
  ],
  "chat_mode": "gmat-geo-gso-orbit-keeping",
  "gmat_reference_script": "references/geo_gso_orbit_keeping.script",
  "gmat_reference_values": "references/geo_gso_orbit_keeping.values.yaml",
  "artifacts": [
    {
      "path": "geo_gso_orbit_keeping.script",
      "kind": "script",
      "primary": true
    },
    {
      "path": "geo_gso_orbit_keeping.values.yaml",
      "kind": "values"
    },
    {
      "path": "GEO_StationKeeping_Chemical_Report.txt",
      "kind": "result"
    },
    {
      "path": "run-analysis-context.json",
      "kind": "result"
    },
    {
      "path": "run_manifest.json",
      "kind": "manifest"
    },
    {
      "path": "satellite.json",
      "kind": "digital-thread",
      "primary": true
    },
    {
      "path": "EphemerisFile1.oem",
      "kind": "ephemeris",
      "primary": true
    },
    {
      "path": "gmat.log",
      "kind": "log"
    }
  ],
  "propulsion_requirement": "chemical",
  "initial_state_representation": "Keplerian",
  "ui": {
    "objective": "Maintain a chemical-propulsion GEO spacecraft within a configurable geographic station-keeping box.",
    "summary": "Chemical GEO station keeping with editable vehicle, controller and propagation-model assumptions.",
    "outputs": [
      "GMAT script and values",
      "Chemical station-keeping report",
      "OEM ephemeris",
      "Run-local satellite.json"
    ],
    "satellite_requirements": [
      "Dry mass",
      "Chemical propellant mass and Isp",
      "Drag area and coefficient"
    ],
    "mission_input_fields": [
      {
        "label": "Initial epoch",
        "path": "initialOrbit.epoch"
      },
      {
        "label": "Semi-major axis",
        "path": "initialOrbit.smaKm",
        "unit": "km"
      },
      {
        "label": "Eccentricity",
        "path": "initialOrbit.eccentricity"
      },
      {
        "label": "Inclination",
        "path": "initialOrbit.inclinationDeg",
        "unit": "deg"
      },
      {
        "label": "RAAN",
        "path": "initialOrbit.raanDeg",
        "unit": "deg"
      },
      {
        "label": "Argument of periapsis",
        "path": "initialOrbit.argPeriapsisDeg",
        "unit": "deg"
      },
      {
        "label": "True anomaly",
        "path": "initialOrbit.trueAnomalyDeg",
        "unit": "deg"
      },
      {
        "label": "Dry mass",
        "path": "spacecraft.dryMassKg",
        "unit": "kg"
      },
      {
        "label": "Initial fuel mass",
        "path": "spacecraft.initialFuelMassKg",
        "unit": "kg"
      },
      {
        "label": "Drag area",
        "path": "spacecraft.dragAreaM2",
        "unit": "m²"
      },
      {
        "label": "Drag coefficient",
        "path": "spacecraft.dragCoefficient"
      },
      {
        "label": "Specific impulse",
        "path": "propulsion.ispSeconds",
        "unit": "s"
      },
      {
        "label": "East/West tolerance",
        "path": "stationKeeping.eastWestToleranceDeg",
        "unit": "deg"
      },
      {
        "label": "North/South tolerance",
        "path": "stationKeeping.northSouthToleranceDeg",
        "unit": "deg"
      },
      {
        "label": "East/West pulse",
        "path": "stationKeeping.eastWestPulseKmPerSec",
        "unit": "km/s"
      },
      {
        "label": "North/South pulse",
        "path": "stationKeeping.northSouthPulseKmPerSec",
        "unit": "km/s"
      },
      {
        "label": "East/West guardband",
        "path": "stationKeeping.eastWestGuardbandDeg",
        "unit": "deg"
      },
      {
        "label": "Control interval",
        "path": "stationKeeping.controlIntervalSecs",
        "unit": "s"
      },
      {
        "label": "Fuel reserve",
        "path": "stationKeeping.fuelReserveKg",
        "unit": "kg"
      },
      {
        "label": "Mission duration",
        "path": "stationKeeping.daysOfOk",
        "unit": "days"
      },
      {
        "label": "Decrement mass",
        "path": "propagation.decrementMass"
      },
      {
        "label": "Include Sun point mass",
        "path": "propagation.includeSun"
      },
      {
        "label": "Include Moon point mass",
        "path": "propagation.includeLuna"
      },
      {
        "label": "Atmosphere model",
        "path": "propagation.atmosphereModel"
      },
      {
        "label": "Relativistic correction",
        "path": "propagation.relativisticCorrection"
      }
    ]
  },
  "mission_inputs": {
    "required": [
      "initial_epoch",
      "full_keplerian_orbit",
      "initial_fuel_mass"
    ],
    "defaults": {
      "north_south_tolerance_deg": 0.05,
      "east_west_tolerance_deg": 0.1,
      "days_of_station_keeping": 30,
      "control_interval_sec": 3600,
      "fuel_reserve_kg": 5
    }
  },
  "satellite_inputs": [
    "satellite.bus.physical.mass_kg.dry",
    "satellite.bus.physical.drag_area_m2",
    "satellite.bus.physical.drag_coefficient",
    "satellite.bus.propulsion_subsystem.specific_impulse_seconds"
  ],
  "downstream_analyses": [
    "simu-cic",
    "opalis",
    "rf-comlink"
  ]
}

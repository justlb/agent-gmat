{
  "id": "electric-propulsion-transfer",
  "name": "Electrical 2D transfer",
  "description": "Deterministic two-dimensional electric transfer using the selected satellite's propulsion and power system.",
  "analysis_request_key": "electric_propulsion_transfer",
  "draft_directory": ["gmat", "electric-propulsion-transfer", "drafts"],
  "chat_mode": "gmat-electric-propulsion",
  "gmat_reference_script": "references/electric_propulsion_transfer.script",
  "gmat_reference_values": "references/electric_propulsion_transfer.values.yaml",
  "artifacts": [
    { "path": "electric_propulsion_transfer.script", "kind": "script" },
    { "path": "electric_propulsion_transfer.values.yaml", "kind": "values" },
    { "path": "gmat_result.json", "kind": "result" },
    { "path": "run-analysis-context.json", "kind": "result" },
    { "path": "run_manifest.json", "kind": "manifest" },
    { "path": "satellite.json", "kind": "digital-thread", "primary": true },
    { "path": "EphemerisFile1.oem", "kind": "ephemeris", "primary": true },
    { "path": "ElectricTransferReport.txt", "kind": "report", "primary": true },
    { "path": "electric_transfer_timeseries.json", "kind": "timeseries" },
    { "path": "gmat.log", "kind": "log" }
  ],
  "propulsion_requirement": "electric",
  "initial_state_representation": "Keplerian",
  "ui": {
    "objective": "Raise an Earth orbit with the satellite's electric thruster and generate a report plus OEM.",
    "summary": "Electrical 2D transfer using ConstantThrustAndIsp with satellite physical properties injected into GMAT.",
    "outputs": ["GMAT script and values", "Electric-transfer report", "OEM ephemeris", "Run-local satellite.json"],
    "satellite_requirements": ["Dry mass", "Electric propellant capacity", "Thruster power limits", "Solar-array power, bus load and margin"],
    "mission_input_fields": [
      { "label": "Initial altitude", "path": "initialOrbit.altitudeKm", "unit": "km", "derived": "initialAltitude", "example_value": 300 },
      { "label": "Initial eccentricity", "path": "initialOrbit.eccentricity", "example_value": 0 },
      { "label": "Initial inclination", "path": "initialOrbit.inclinationDeg", "unit": "deg", "example_value": 0 },
      { "label": "Final altitude", "path": "transfer.finalAltitudeKm", "unit": "km", "example_value": 7000 },
      { "label": "Initial epoch (optional)", "path": "initialOrbit.epoch", "example_value": "31262.66709490726" },
      { "label": "Initial RAAN (optional)", "path": "initialOrbit.raanDeg", "unit": "deg", "example_value": 0 },
      { "label": "Initial AOP (optional)", "path": "initialOrbit.argPeriapsisDeg", "unit": "deg", "example_value": 0 },
      { "label": "Initial true anomaly (optional)", "path": "initialOrbit.trueAnomalyDeg", "unit": "deg", "example_value": 0 },
      { "label": "Loaded fuel mass (optional)", "path": "spacecraft.initialFuelMassKg", "unit": "kg", "example_value": 756 }
    ]
  },
  "mission_inputs": {
    "required": ["initial_epoch", "initial_orbit", "target_final_altitude_km"],
    "defaults": {}
  },
  "satellite_inputs": [
    "satellite.bus.physical.mass_kg.dry",
    "satellite.bus.propulsion_subsystem.electric_thruster.propellant_mass_kg",
    "satellite.bus.propulsion_subsystem.electric_thruster.minimum_usable_power_kw",
    "satellite.bus.propulsion_subsystem.electric_thruster.maximum_usable_power_kw",
    "satellite.bus.electrical_subsystem.solar_panels.total_power_generated_watts"
  ],
  "downstream_analyses": ["simu-cic", "opalis", "rf-comlink"]
}

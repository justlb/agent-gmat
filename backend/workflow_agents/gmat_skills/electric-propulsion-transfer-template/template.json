      "Electric propellant capacity",
      "Thruster power limits",
      "Solar-array power, bus load and margin"
    ],
    "mission_input_fields": [
      {
        "label": "Initial epoch",
        "path": "initialOrbit.epoch",
        "required": false
      },
      {
        "label": "Initial altitude",
        "path": "initialOrbit.altitudeKm",
        "unit": "km",
        "derived": "initialAltitude"
      },
      {
        "label": "Initial semi-major axis",
        "path": "initialOrbit.smaKm",
        "unit": "km"
      },
      {
        "label": "Initial eccentricity",
        "path": "initialOrbit.eccentricity"
      },
      {
        "label": "Initial inclination",
        "path": "initialOrbit.inclinationDeg",
        "unit": "deg"
      },
      {
        "label": "Target final altitude",
        "path": "transfer.finalAltitudeKm",
        "unit": "km"
      }
    ]
  },
  "mission_inputs": {
    "required": [
      "initial_epoch",
      "initial_orbit",
      "target_final_altitude_km"
    ],
    "defaults": {}
  },
  "satellite_inputs": [
    "satellite.bus.physical.mass_kg.dry",
    "satellite.bus.propulsion_subsystem.electric_thruster.propellant_mass_kg",
    "satellite.bus.propulsion_subsystem.electric_thruster.minimum_usable_power_kw",
    "satellite.bus.propulsion_subsystem.electric_thruster.maximum_usable_power_kw",
    "satellite.bus.propulsion_subsystem.nominal_thrust_newtons",
    "satellite.bus.propulsion_subsystem.specific_impulse_seconds",
    "satellite.bus.propulsion_subsystem.electric_thruster.nominal_thruster_power_kw",
    "satellite.bus.electrical_subsystem.solar_panels.total_power_generated_watts",
    "satellite.bus.electrical_subsystem.electric_propulsion_mode.bus_load_kw",
    "satellite.bus.electrical_subsystem.batteries.capacity_ah",
    "satellite.bus.electrical_subsystem.batteries.energy_wh"

{
  "id": "orbit-keeping",
  "name": "LEO Orbit Maintenance (Chemical)",
  "description": "Chemical-propulsion LEO station keeping with drag decay and reboost events.",
  "analysis_request_key": "orbit_keeping",
  "draft_directory": ["gmat", "drafts"],
  "chat_mode": "gmat-orbit-keeping",
  "gmat_reference_script": "references/orbit_keeping.script",
  "gmat_reference_values": "references/orbit_keeping.values.yaml",
  "artifacts": [
    { "path": "orbit_keeping.script", "kind": "script" },
    { "path": "orbit_keeping.values.yaml", "kind": "values" },
    { "path": "gmat_result.json", "kind": "result" },
    { "path": "run-analysis-context.json", "kind": "result" },
    { "path": "run_manifest.json", "kind": "manifest" },
    { "path": "satellite.json", "kind": "digital-thread", "primary": true },
    { "path": "EphemerisFile1.oem", "kind": "ephemeris", "primary": true },
    { "path": "ReboostReport.txt", "kind": "report", "primary": true },
    { "path": "OrbitAnalysisReport.txt", "kind": "report" },
    { "path": "orbit_timeseries.json", "kind": "timeseries" },
    { "path": "opalis/03-opalis/02-resultats/calculated-opalis-timeseries.json", "kind": "opalis" },
    { "path": "gmat.log", "kind": "log" }
  ],
  "propulsion_requirement": "chemical",
  "initial_state_representation": "Keplerian",
  "mission_inputs": {
    "required": ["initial_epoch", "initial_orbit", "minimum_reboost_altitude"],
    "defaults": {}
  },
  "satellite_inputs": [
    "satellite.bus.physical.mass_kg.dry",
    "satellite.bus.physical.drag_area_m2",
    "satellite.bus.physical.drag_coefficient",
    "satellite.bus.propulsion_subsystem.specific_impulse_seconds"
  ],
  "downstream_analyses": ["simu-cic", "opalis", "rf-comlink"]
}

{
  "id": "chemical-hohmann-transfer",
  "name": "Chemical 2D transfer",
  "description": "Two-impulse chemical Earth-orbit transfer with propellant depletion, solved by GMAT's differential corrector.",
  "analysis_request_key": "chemical_hohmann_transfer",
  "draft_directory": ["gmat", "chemical-hohmann-transfer", "drafts"],
  "chat_mode": "gmat-chemical-hohmann",
  "gmat_reference_script": "references/chemical_hohmann_transfer.script",
  "artifacts": [
    { "path": "chemical_hohmann_transfer.script", "kind": "script" },
    { "path": "chemical_hohmann_transfer.values.yaml", "kind": "values" },
    { "path": "gmat_result.json", "kind": "result" },
    { "path": "ReportFile1.txt", "kind": "report" },
    { "path": "chemical_hohmann_timeseries.json", "kind": "timeseries" },
    { "path": "run-analysis-context.json", "kind": "result" },
    { "path": "run_manifest.json", "kind": "manifest" },
    { "path": "satellite.json", "kind": "digital-thread", "primary": true },
    { "path": "satellite.digital-thread.json", "kind": "digital-thread" },
    { "path": "EphemerisFile1.oem", "kind": "ephemeris", "primary": true },
    { "path": "gmat.log", "kind": "log" }
  ],
  "source": "GMAT Chemical 2D Transfer.script",
  "propulsion_requirement": "chemical",
  "initial_state_representation": "Keplerian",
  "ui": {
    "objective": "Raise or lower an Earth orbit using two chemical burns, then generate an OEM and an altitude/fuel report.",
    "summary": "Chemical 2D transfer with satellite physical properties injected from the satellite library.",
    "outputs": ["GMAT script and values", "Altitude and fuel report", "OEM ephemeris", "Run-local satellite.json"],
    "satellite_requirements": ["Dry mass", "Chemical propellant mass and Isp", "Drag and SRP properties"],
    "mission_input_fields": [
      { "label": "Initial altitude", "path": "initialOrbit.altitudeKm", "unit": "km", "example_value": 2621.8637 },
      { "label": "Initial eccentricity", "path": "initialOrbit.eccentricity", "example_value": 0 },
      { "label": "Initial inclination", "path": "initialOrbit.inclinationDeg", "unit": "deg", "example_value": 0 },
      { "label": "Final altitude", "path": "transfer.targetAltitudeKm", "unit": "km", "example_value": 35786.0327 },
      { "label": "Initial epoch (optional)", "path": "initialOrbit.epoch", "example_value": 21545 },
      { "label": "Initial RAAN (optional)", "path": "initialOrbit.raanDeg", "unit": "deg", "example_value": 0 },
      { "label": "Initial AOP (optional)", "path": "initialOrbit.argPeriapsisDeg", "unit": "deg", "example_value": 0 },
      { "label": "Initial true anomaly (optional)", "path": "initialOrbit.trueAnomalyDeg", "unit": "deg", "example_value": 0 },
      { "label": "Final propagation time (optional)", "path": "transfer.finalPropagationSeconds", "unit": "s", "example_value": 86400 },
      { "label": "Loaded fuel mass (optional)", "path": "spacecraft.initialFuelMassKg", "unit": "kg", "example_value": 2200 }
    ]
  },
  "mission_inputs": {
    "required": [
      "initial_altitude",
      "initial_eccentricity",
      "initial_inclination",
      "final_altitude"
    ],
    "defaults": {
      "target_eccentricity": 0,
      "final_propagation_seconds": 86400
    }
  },
  "satellite_inputs": [
    "satellite.bus.physical.mass_kg.dry",
    "satellite.bus.physical.drag_area_m2",
    "satellite.bus.physical.drag_coefficient",
    "satellite.bus.propulsion_subsystem.specific_impulse_seconds",
    "satellite.bus.physical.mass_kg.propellant"
  ],
  "downstream_analyses": ["simu-cic", "opalis", "rf-comlink"],
  "planned_physical_extension": {
    "status": "not_enabled",
    "description": "The canonical tutorial keeps DecrementMass=false. A separate, validated variant will add a chemical tank and propellant depletion after this baseline is verified."
  }
}

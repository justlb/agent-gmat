{
  "name": "codex-web-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:gmat:baseline": "node --import tsx --test tests/gmat/gmatTemplateBaseline.test.ts tests/gmat/orbitKeepingValues.test.ts tests/gmat/electricPropulsionService.test.ts tests/digitalThread/digitalThreadGmatFlow.test.ts",
    "test:e2e:thermal": "node --import tsx --test tests/e2e/thermalModelBackends.e2e.test.ts",
    "test:gmat:electric": "node --import tsx --test tests/gmat/electricPropulsionDraft.test.ts tests/gmat/electricPropulsionRunner.test.ts tests/gmat/electricPropulsionService.test.ts",
    "test:e2e:gmat:electric": "node --import tsx --test tests/e2e/electricPropulsionGmat.e2e.test.ts"
    ,"test:e2e:digital-thread": "node --import tsx --test tests/e2e/digitalThreadMissionConsistency.e2e.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@openai/codex-sdk": "^0.129.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "pinyin-pro": "^3.28.1",
    "undici": "^7.28.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
